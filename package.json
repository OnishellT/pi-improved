{
  "name": "pi-improved",
  "version": "0.1.0",
  "description": "Automatic project setup for Pi: discovery, interview, connectors, docs and a verify gate",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/OnishellT/pi-improved.git" },
  "bugs": { "url": "https://github.com/OnishellT/pi-improved/issues" },
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "pi": {
    "extensions": ["./src/index.ts", "./src/computer/index.ts", "./src/self-compact/index.ts"]
  },
  "dependencies": {
    "@aurelienbbn/agentlint": "^0.9.1",
    "@earendil-works/pi-subagent": "github:OnishellT/pi-subagent#25e85fca97270cecd1315119e110d9a6195e78a4",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "review": "node scripts/review-pr.ts"
  }
