{
  "name": "pi-improved",
  "version": "0.1.0",
  "description": "Automatic project setup for Pi: discovery, interview, connectors, docs and a verify gate",
  "type": "module",
  "private": true,
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.18.0" },
  "pi": {
    "extensions": ["./src/index.ts", "./src/computer/index.ts", "./src/self-compact/index.ts"]
  },
  "dependencies": {
    "@aurelienbbn/agentlint": "^0.9.1",
    "@earendil-works/pi-subagent": "github:badlogic/pi-subagent#4fc1fe5178d1a2b474794a5ee39e7295844e9d3c",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "review": "node scripts/review-pr.ts"
  }
}
